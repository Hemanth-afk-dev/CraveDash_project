# Change these placeholders before starting the application.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-root-password
DB_PASSWORD=replace-with-a-strong-application-database-password
JWT_SECRET=replace-with-at-least-32-random-utf8-characters

# Public browser origin and API URL baked into the frontend build.
REACT_APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Optional host ports.
FRONTEND_PORT=5173
API_GATEWAY_PORT=8080
EUREKA_PORT=8761
